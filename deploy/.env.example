# ============================================================
#  harvest PORTAL — переменные окружения
#  Копия:   cp .env.example .env          (заполните значения)
#  Никогда не публикуйте .env (в .gitignore).
# ============================================================

# --- ОБЯЗАТЕЛЬНО: СВОЙ ключ, генерация: ---
#   python -c "import secrets; print(secrets.token_hex(32))"
# 64-hex: ключ шифрования БД И мастер-пароль входа в веб.
# ВНИМАНИЕ: НЕ оставляйте здесь текст-заглушку (например REPLACE_WITH_64_HEX) —
# портал в этом случае использует её как «PIN» веб-входа (слабый публичный пароль).
# Пусто = парольный вход в веб ВЫКЛЮЧЕН (fail-closed: только Google OAuth).
# ВАЖНО: если пуст и FARMER_MASTER_KEY, и GOOGLE_*, и TELEGRAM_BOT_TOKEN —
# портал НЕ стартует вовсе (нет ни одного способа входа): это по замыслу.
FARMER_MASTER_KEY=

# Секрет подписи сессий (>= 16 символов). Если оставить пустым —
# создастся автоматически в /app/data/portal_secret.key и переживёт рестарт.
PORTAL_SECRET=

# --- Вход в веб ---
PORTAL_PASSWORD_LOGIN=1
# Пароль по HTTP разрешён ТОЛЬКО при доступе через localhost/SSH-tunnel
# (по умолчанию портал публикуется на 127.0.0.1:8080).
# Для публичного веба поставьте Caddy (HTTPS) и уберите этот флаг.
PORTAL_ALLOW_PASSWORD_HTTP=0

# --- Telegram-бот (добавить позже) ---
# Токен — у @BotFather, свой user_id — у @userinfobot.
# Пустые значения = бот выключен (портал работает в режиме веб-only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOW_IDS=
# Бот строго default-deny: без TELEGRAM_ALLOW_IDS он никому не отвечает.
# Владелец: расширенная панель /admin только для него (в allowlist выше
# тоже должен быть — default-deny един для всех; ID по умолчанию в коде).
# TELEGRAM_OWNER_ID=397602448
# PORTAL_OPEN_ACCESS=1   # НЕ включать бездумно — откроет бота всем подряд.

# --- Сторожевой монитор (алерты владельцу через бота) ---
# PORTAL_WATCH_INTERVAL_S=300   # период опроса статистики, сек
# PORTAL_HEARTBEAT_HOURS=0      # периодический «пульс» владельцу, ч (0 = выкл)

# --- Google OAuth (опционально) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOW_EMAILS=you@gmail.com
# GOOGLE_REDIRECT_URI=https://your.domain/auth/google/callback

# --- Mini App (этап 3): публичный HTTPS обязателен ---
# PORTAL_BASE_URL=https://your.domain
# PORTAL_MINIAPP_URL=https://your.domain/app/   # кнопка Mini App в боте (по умолчанию base+/app/)
# PORTAL_MINIAPP_PUBLIC=1   # снаружи только /app/*, /api/miniapp/*, /static/*, /healthz (остальное 404)
# PORTAL_TRUST_PROXY=1      # за Caddy — обязательно

# --- Сменить сеть фермера ---
# FARM_CONFIG читается docker-compose.yml и подставляется в PORTAL_FARM_CONFIG.
# Варианты: /app/config_vibevibe.yaml (по умолчанию), /app/config_robinhood.yaml,
# /app/config_flop.yaml, /app/config_arc.yaml, /app/config.simple.yaml.
# FARM_CONFIG=/app/config_robinhood.yaml
# PORTAL_SECRET_FILE и PORTAL_REVOKED_FILE заданы в docker-compose.yml
# (/app/data/...) и меняются только вместе с compose-файлом.