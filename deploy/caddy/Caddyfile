# HARVEST PORTAL — публичный HTTPS-реверс (Caddy).
#
# Установка:  скопируйте в deploy/caddy/Caddyfile и подставьте домен,
#             затем:  docker compose -f docker-compose.yml -f docker-compose.caddy.yml up -d --build
#             В deploy/.env:  PORTAL_ALLOW_PASSWORD_HTTP= (пусто)  и  PORTAL_TRUST_PROXY=1
#
# !!! ЗАМЕНИТЕ your-domain.com на ваш реальный домен (A-запись на сервер) !!!
# Caddy автоматически выпустит LetsEncrypt-сертификат (порты 80/443 открыты).

your-domain.com {
    reverse_proxy portal:8080

    # Mini App в Telegram живёт в iframe — Caddy не должен мешать.
    header {
        -X-Frame-Options
    }
}